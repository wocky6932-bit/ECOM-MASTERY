datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid()) @db.VarChar(36)
  name          String         @db.VarChar(255)
  email         String         @unique @db.VarChar(255)
  phone         String?        @db.VarChar(30)
  passwordHash  String         @db.VarChar(255)
  role          String         @default("CLIENT") @db.VarChar(10)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  accessCodes   AccessCode[]
  sessions      Session[]
  readings      ReadingProgress[]
}

model Product {
  id              String            @id @default(uuid()) @db.VarChar(36)
  title           String            @db.VarChar(255)
  slug            String            @unique @db.VarChar(255)
  shortDesc       String            @db.Text
  description     String            @db.Text
  learnPoints     String            @db.Text
  targetAudience  String            @db.Text
  price           Int               @default(5000)
  currency        String            @default("XOF") @db.VarChar(10)
  coverImage      String            @db.VarChar(500)
  category        String            @default("E-commerce") @db.VarChar(100)
  privateFileKey  String?           @db.VarChar(500)
  chapters        String            @db.LongText
  status          String            @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  orders          Order[]
  accessCodes     AccessCode[]
  readings        ReadingProgress[]
}

model Order {
  id            String       @id @default(uuid()) @db.VarChar(36)
  orderNumber   String       @unique @db.VarChar(50)
  userId        String       @db.VarChar(36)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String       @db.VarChar(36)
  product       Product      @relation(fields: [productId], references: [id])
  amount        Int          @default(5000)
  currency      String       @default("XOF") @db.VarChar(10)
  status        String       @default("PENDING") @db.VarChar(20)
  customerName  String       @db.VarChar(255)
  customerEmail String       @db.VarChar(255)
  customerPhone String       @db.VarChar(30)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  payments      Payment[]
  accessCodes   AccessCode[]

  @@index([userId])
  @@index([productId])
}

model Payment {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  orderId            String    @db.VarChar(36)
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           String    @default("WAVE") @db.VarChar(20)
  providerReference  String?   @db.VarChar(255)
  checkoutUrl        String?   @db.Text
  amount             Int
  currency           String    @default("XOF") @db.VarChar(10)
  status             String    @default("PENDING") @db.VarChar(20)
  rawWebhookPayload  String?   @db.LongText
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([orderId])
}

model AccessCode {
  id          String    @id @default(uuid()) @db.VarChar(36)
  code        String    @db.VarChar(30)
  codeHash    String    @unique @db.VarChar(64)
  userId      String    @db.VarChar(36)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String    @db.VarChar(36)
  product     Product   @relation(fields: [productId], references: [id])
  orderId     String    @db.VarChar(36)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String    @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId])
  @@index([productId])
  @@index([orderId])
}

model Session {
  id                String    @id @default(uuid()) @db.VarChar(36)
  userId            String    @db.VarChar(36)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token             String    @unique @db.VarChar(512)
  deviceFingerprint String?   @db.VarChar(255)
  deviceName        String?   @db.VarChar(255)
  ipAddress         String?   @db.VarChar(45)
  lastActivity      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?

  @@index([userId])
}

model ReadingProgress {
  id            String    @id @default(uuid()) @db.VarChar(36)
  userId        String    @db.VarChar(36)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String    @db.VarChar(36)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  lastPosition  Int       @default(1)
  lastChapterId String?   @db.VarChar(100)
  progressPct   Int       @default(0)
  updatedAt     DateTime  @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  adminId   String?  @db.VarChar(36)
  action    String   @db.VarChar(100)
  metadata  String?  @db.Text
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())
}
