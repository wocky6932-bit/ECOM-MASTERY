# ECOM MASTERY - Environment Variables

# Base URL de l'application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base de données (SQLite en dev local / PostgreSQL en production)
DATABASE_URL="file:./dev.db"

# JWT Secret pour la signature des sessions sécurisées (min 32 caractères)
JWT_SECRET="ecom_mastery_super_secret_jwt_key_2026_dev_mode"

# Wave Checkout API (https://docs.wave.com/checkout)
# En mode développement, si aucune clé réelle n'est renseignée, un simulateur Wave sécurisé est activé.
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""

# Email notifications (SMTP ou provider tel que Resend / Sendgrid)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Ecom Mastery <contact@ecommastery.sn>"

# Admin par défaut
ADMIN_DEFAULT_EMAIL="admin@ecommastery.sn"
ADMIN_DEFAULT_PASSWORD="AdminMastery2026!"
